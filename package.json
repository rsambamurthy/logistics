{
  "name": "quayly",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Quayly - freight quote sourcing and comparison for C&F agents",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "cd client && npm install --include=dev && npm run build",
    "start": "node server/index.js",
    "dev": "node --watch server/index.js",
    "test": "node --test server/tests/*.test.js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.6",
    "express": "^4.21.0",
    "imapflow": "^1.0.164",
    "jsonwebtoken": "^9.0.2",
    "mailparser": "^3.7.1",
    "multer": "^2.5.0",
    "nodemailer": "^6.9.15",
    "pdfkit": "^0.15.0",
    "pg": "^8.13.0",
    "xlsx": "^0.18.5"
  }
}
